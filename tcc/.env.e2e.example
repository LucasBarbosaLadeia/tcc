# Variáveis de ambiente para os testes E2E com Playwright
# Copie para .env.e2e e preencha com as credenciais dos usuários de teste
# NUNCA commite o arquivo .env.e2e com senhas reais

# URL base do frontend (Vite dev server — porta 5173)
E2E_BASE_URL=http://localhost:5173

# Credenciais ADMIN (usuário deve existir no banco de desenvolvimento)
E2E_ADMIN_EMAIL=admin@saude.com
E2E_ADMIN_PASSWORD=troque_pela_senha_do_admin

# Credenciais RECEPCIONISTA (usuário deve existir no banco de desenvolvimento)
E2E_RECEP_EMAIL=recep@teste.com
E2E_RECEP_PASSWORD=troque_pela_senha_da_recepcionista

# Credenciais PACIENTE (usuário deve existir no banco de desenvolvimento)
E2E_PACIENTE_EMAIL=joao@teste.com
E2E_PACIENTE_PASSWORD=troque_pela_senha_do_paciente
