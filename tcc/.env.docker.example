# Variáveis usadas pelo Docker Compose
# Copie para .env e preencha antes de rodar: docker compose up
# NUNCA commite o arquivo .env com senhas reais

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=troque_a_senha_root
MYSQL_DATABASE=saude_na_mao
MYSQL_USER=app
MYSQL_PASSWORD=troque_a_senha_banco

# ── Backend ────────────────────────────────────────────────────────────────
DB_HOST=database
DB_PORT=3306
DB_USER=app
DB_PASSWORD=troque_a_senha_banco
DB_NAME=saude_na_mao
JWT_SECRET=troque_por_chave_aleatoria_com_no_minimo_32_caracteres
JWT_EXPIRES_IN=1d
NODE_ENV=production

# ── CORS (origens permitidas, separadas por vírgula) ───────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Grafana ────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=troque_a_senha_grafana
