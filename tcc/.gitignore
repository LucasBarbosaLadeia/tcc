# ===== VARIÁVEIS DE AMBIENTE =====
# Ignorar arquivos reais de ambiente (podem conter senhas)
.env
.env.*

# Permitir explicitamente os arquivos de exemplo (sem senhas reais)
!.env.example
!.env.*.example

# ===== DEPENDÊNCIAS NODE =====
node_modules/
Backend/node_modules/
Frontend/node_modules/
.package-lock.json

